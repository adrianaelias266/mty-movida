{
  // Configuración para Cloudflare: publica la carpeta "public" como sitio
  // y usa worker.js solo para lo que no es un archivo (por ejemplo, /cal/<id>.ics)
  "name": "mty-movida",
  "compatibility_date": "2026-10-01",
  "main": "worker.js",
  "assets": {
    "directory": "./public", "binding": "ASSETS",
    // Direcciones sin # (mtymovida.com/calendario): cualquier dirección que no sea un archivo abre la página
    "not_found_handling": "single-page-application",
    // Estas direcciones las atiende worker.js (vista previa al compartir y calendarios)
    "run_worker_first": ["/e/*", "/cal/*"]
  }
}
